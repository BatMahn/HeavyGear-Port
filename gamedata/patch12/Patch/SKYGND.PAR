#
# tik's wonderful world of skygnd.par
#
# mission=(mission name, first 4 letters)
# globalintensity=(software global light; see artfile for software ambient)
# hardwareintensity=(D3D global light)
# hardwareambient=(D3D ambient light; minimum light in world)
# gintensity=(gouraud mode global light)
# gambient=(gouraud mode ambient light; minimum light in world)
# skytexture=(texture of the scrolling sky in D3D)
# horizontexture=(texture of the horizon in software only)
# hardwarehorizon=(texture of the horizon in D3D)
# horizontile=(number of times the texture tiles horizonally; both D3D and software)
# skycolor=(indexcolor of solid color above the software horizontexture),
#          (alpha channel of scrolling sky in d3d; 255-fully opaque 0-fully translucent), 
#	   (indexcolor of solid color below the software horizontexture), 
#	   (scrolling sky tiling rate), 
#	   (indexcolor of solid color above the hardware horizontexture), 
#	   (indexcolor of solid color below the hardware horizontexture)
# fogswitch=(in hardware: 1=fog to fog color, 0=no fog, 1=fog to fog color)
#           (in software: 1=fog up the luma, 0=no fog, -1=fog down the luma)
#	    (in software, shadedist always overrides fogswitch)	
# fogcolor=(fog color for d3d red,green,blue,alpha)
# skyspeed=(speed of sky. texels/sec)
# density=(fog density: Y-distance in Y direction, M-min. density normalized between 0 and 1, Z-min. distance in Z)
#

